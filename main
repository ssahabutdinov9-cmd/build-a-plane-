    task.wait(1)
    stopSelfFlight()
    if Farm.running then
        notifyFunc("Респавн — авто-фарм продолжается", COLORS.cyan)
    end
end)

-- Полная остановка при повторной загрузке скрипта
_G.INFINITY_HUB_BAP_STOP = function()
    stopFarm()
    Settings.autoBuy = false
    Settings.autoSpin = false
    Settings.aurora = false
    pcall(function()
        local gui = GUI_PARENT and GUI_PARENT:FindFirstChild("INFINITY_HUB_BAP")
        if gui then gui:Destroy() end
    end)
end

