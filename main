if Settings.autoSpin then autoSpinLoop() end
if Settings.aurora then auroraLoop() end

-- Авто-фарм, включённый до перезахода, продолжаем автоматически
if Settings.autoFarm then
    task.spawn(function()
        task.wait(3)
        if Settings.autoFarm and not Farm.running then
            Farm.running = true
            task.spawn(farmLoop)
        end
    end)
end

