local MODES = { "АВТО", "РАКЕТА", "ТЕЛЕПОРТ" }
local modeDesc = {
    ["АВТО"] = "сам выбирает рабочий метод",
    ["РАКЕТА"] = "скорость 1B => миллионы $",
    ["ТЕЛЕПОРТ"] = "надёжно ~$600/рейс",
}
local modeButton = make("TextButton", {
    Size = UDim2.new(1, -4, 0, 34),
    BackgroundColor3 = Color3.fromRGB(70, 45, 140),
    BorderSizePixel = 0,
