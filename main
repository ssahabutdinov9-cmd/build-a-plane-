local layoutOrder = 0
local function nextOrder()
    layoutOrder = layoutOrder + 1
    return layoutOrder
end

-- Переключатель
local function makeToggle(parent, text, initial, callback)
    local state = initial and true or false
    local btn = make("TextButton", {
        Size = UDim2.new(1, -4, 0, 34),
        BackgroundColor3 = state and COLORS.on or COLORS.off,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = true,
        LayoutOrder = nextOrder(),
    }, parent)
    make("UICorner", { CornerRadius = UDim.new(0, 8) }, btn)
    local label = make("TextLabel", {
        Size = UDim2.new(1, -52, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = COLORS.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.SourceSansSemibold,
        TextSize = 15,
    }, btn)
    local stateLabel = make("TextLabel", {
        Size = UDim2.new(0, 48, 1, 0),
        Position = UDim2.new(1, -54, 0, 0),
        BackgroundTransparency = 1,
        Text = state and "ВКЛ" or "ВЫКЛ",
        TextColor3 = state and Color3.fromRGB(140, 255, 160) or Color3.fromRGB(200, 200, 210),
        TextXAlignment = Enum.TextXAlignment.Right,
        Font = Enum.Font.SourceSansBold,
        TextSize = 14,
    }, btn)
    local api = {}
    local function render()
        btn.BackgroundColor3 = state and COLORS.on or COLORS.off
        stateLabel.Text = state and "ВКЛ" or "ВЫКЛ"
        stateLabel.TextColor3 = state and Color3.fromRGB(140, 255, 160) or Color3.fromRGB(200, 200, 210)
    end
    btn.MouseButton1Click:Connect(function()
        state = not state
        render()
        callback(state)
    end)
    function api.set(newValue, silent)
        state = newValue and true or false
        render()
        if not silent then
            callback(state)
        end
    end
    function api.get()
        return state
    end
    render()
    return api
end

-- Слайдер
local function makeSlider(parent, text, minV, maxV, step, initial, fmtFunc, callback)
    local container = make("Frame", {
        Size = UDim2.new(1, -4, 0, 40),
        BackgroundTransparency = 1,
        LayoutOrder = nextOrder(),
    }, parent)
    local capLabel = make("TextLabel", {
        Size = UDim2.new(1, -10, 0, 16),
        Position = UDim2.new(0, 5, 0, 0),
        BackgroundTransparency = 1,
        Text = text .. ": " .. fmtFunc(initial),
        TextColor3 = COLORS.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.SourceSans,
        TextSize = 13,
    }, container)
    local bar = make("Frame", {
        Size = UDim2.new(1, -10, 0, 8),
        Position = UDim2.new(0, 5, 0, 24),
        BackgroundColor3 = Color3.fromRGB(50, 50, 66),
        BorderSizePixel = 0,
    }, container)
    make("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)
    local fill = make("Frame", {
        Size = UDim2.new((initial - minV) / (maxV - minV), 0, 1, 0),
        BackgroundColor3 = COLORS.accent,
        BorderSizePixel = 0,
    }, bar)
    make("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)

    local value = initial
    local sliding = false
    local function setValueFromX(x)
        local frac = (x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1)
        frac = math.clamp(frac, 0, 1)
        local raw = minV + (maxV - minV) * frac
        local snapped = math.floor(raw / step + 0.5) * step
        if snapped < minV then snapped = minV end
        if snapped > maxV then snapped = maxV end
        value = snapped
        fill.Size = UDim2.new(frac, 0, 1, 0)
        capLabel.Text = text .. ": " .. fmtFunc(value)
        callback(value)
    end
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            setValueFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            setValueFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)
    return {
        get = function() return value end,
        refresh = function()
            capLabel.Text = text .. ": " .. fmtFunc(value)
            fill.Size = UDim2.new((value - minV) / (maxV - minV), 0, 1, 0)
        end,
    }
end

-- Кнопка-действие (в скролл)
local function makeActionButton(parent, text, color, callback)
    local btn = make("TextButton", {
        Size = UDim2.new(1, -4, 0, 34),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = COLORS.text,
        Font = Enum.Font.SourceSansBold,
        TextSize = 15,
        AutoButtonColor = true,
        LayoutOrder = nextOrder(),
    }, parent)
    make("UICorner", { CornerRadius = UDim.new(0, 8) }, btn)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

