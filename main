local modeText = make("TextLabel", {
    Size = UDim2.new(1, -20, 1, 0),
    Position = UDim2.new(0, 10, 0, 0),
    BackgroundTransparency = 1,
    Text = "Режим: " .. Settings.method,
    TextColor3 = COLORS.text,
    TextXAlignment = Enum.TextXAlignment.Left,
    Font = Enum.Font.SourceSansSemibold,
    TextSize = 15,
}, modeButton)
modeButton.MouseButton1Click:Connect(function()
    local current = 1
    for i, m in ipairs(MODES) do
        if m == Settings.method then current = i break end
    end
    current = current + 1
    if current > #MODES then current = 1 end
    Settings.method = MODES[current]
    modeText.Text = "Режим: " .. Settings.method .. "  (" .. modeDesc[Settings.method] .. ")"
    notifyFunc("Режим: " .. Settings.method, COLORS.cyan)
    saveSettings()
end)

