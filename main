-- Защита от двойного запуска: глушим старую копию
if _G.INFINITY_HUB_BAP_STOP then
    pcall(_G.INFINITY_HUB_BAP_STOP)
end

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService  = game:GetService("UserInputService")
local RunService        = game:GetService("RunService")
local HttpService       = game:GetService("HttpService")
local TweenService      = game:GetService("TweenService")
local VirtualUser       = game:GetService("VirtualUser")

local Player    = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

if game.PlaceId ~= 137925884276740 then
    warn("[INFINITY HUB] Внимание: это не Build A Plane (PlaceId: " .. tostring(game.PlaceId) .. ") — пробую всё равно.")
end

-- ═══════════════════════════ НАСТРОЙКИ ═══════════════════════════

local PLANE_VEL      = Vector3.new(1e9, 0, 0)    -- проверенная скорость самолёта
local SELF_VEL       = Vector3.new(1e9, 250, 0)  -- самостоятельный полёт (с набором высоты)
local TP_ALT         = 9000000000                 -- высота телепорта (проверенное значение)
local LAUNCH_WAIT    = 0.8                        -- пауза после Launch до разгона
local REWARD_WAIT    = 1.4                        -- ожидание начисления после Return
local CYCLE_PAUSE    = 1.0                        -- пауза между циклами фарма
local SEAT_RANGE     = 500                        -- радиус поиска "своего" сиденья
local WATCHDOG_EXTRA = 12                         -- страховка возврата, сек

local Settings = {
    method      = "АВТО",   -- АВТО / РАКЕТА / ТЕЛЕПОРТ
    flightTime  = 2.0,      -- время полёта до возврата (сек)
    tpDistance  = 15000,    -- дистанция для телепорт-метода
    antiAfk     = true,
    autoBuy     = false,
    autoSpin    = false,
    aurora      = false,
    autoFarm    = false,
}

local SETTINGS_PATH = "INFINITY_HUB/bap_settings.json"

-- ═══════════════════════════ УТИЛИТЫ ═══════════════════════════

local function formatMoney(n)
    n = math.floor((n or 0) + 0.5)
    local s = tostring(n)
    local out = ""
    local count = 0
    for i = #s, 1, -1 do
        out = s:sub(i, i) .. out
        count = count + 1
        if count % 3 == 0 and i > 1 then
            out = " " .. out
        end
    end
    return out
end

local function shortMoney(n)
    if n >= 1e9 then
        return string.format("%.2fB", n / 1e9)
    elseif n >= 1e6 then
        return string.format("%.2fM", n / 1e6)
    elseif n >= 1e3 then
        return string.format("%.1fK", n / 1e3)
    end
    return tostring(math.floor(n))
end

local function getHRP()
    local char = Player.Character
    if not char then return nil, nil end
    return char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid")
end

local function getLeaderstat(name)
    local ls = Player:FindFirstChild("leaderstats")
    if not ls then return nil end
    local v = ls:FindFirstChild(name)
    if not v then return nil end
    return tonumber(v.Value)
end

local function getCash()
    local ok, v = pcall(getLeaderstat, "Cash")
    if ok and v then return v end
    return 0
end

local function getDistance()
    local ok, v = pcall(getLeaderstat, "Distance")
    if ok and v then return v end
    return 0
end

-- ═══════════════════════════ РЕМОУТЫ ═══════════════════════════

local Remotes = {}
local remotesReady = false

do
    local ok, err = pcall(function()
        local remotesFolder = ReplicatedStorage:WaitForChild("Remotes", 15)
        assert(remotesFolder, "папка Remotes не найдена")
        local launchEvents = remotesFolder:WaitForChild("LaunchEvents", 15)
        Remotes.Launch = launchEvents:WaitForChild("Launch", 15)
        Remotes.Return = launchEvents:WaitForChild("Return", 15)
        local shopEvents = remotesFolder:WaitForChild("ShopEvents", 15)
        Remotes.BuyBlock = shopEvents:WaitForChild("BuyBlock", 15)
        local spinEvents = remotesFolder:WaitForChild("SpinEvents", 10)
        if spinEvents then
            Remotes.PurchaseSpin = spinEvents:WaitForChild("PurchaseSpin", 10)
            Remotes.PerformSpin  = spinEvents:WaitForChild("PerformSpin", 10)
        end
        local uiEvents = remotesFolder:WaitForChild("UIEvents", 10)
        if uiEvents then
            Remotes.AuroraCollect = uiEvents:WaitForChild("AuroraCollect", 10)
        end
    end)
    if ok and Remotes.Launch and Remotes.Return then
        remotesReady = true
    else
        warn("[INFINITY HUB] Ошибка поиска ремоутов: " .. tostring(err))
    end
end

local function fireRemote(remote, ...)
    if not remote then return false end
    local ok, err = pcall(function(...)
        remote:FireServer(...)
    end, ...)
    if not ok then
        warn("[INFINITY HUB] FireServer(" .. tostring(remote.Name) .. "): " .. tostring(err))
    end
    return ok
end

local function invokeRemote(remote, ...)
    if not remote then return nil end
    local ok, res = pcall(function(...)
        return remote:InvokeServer(...)
    end, ...)
    if ok then return res end
    return nil
end

-- ═══════════════════════════ ДВИЖОК ФАРМА (состояние) ═══════════════════════════

local Farm = {
    running     = false,
    flying      = false,
    launchT     = 0,
    runs        = 0,
    totalEarned = 0,
    sessionCash = 0,
    sessionT    = os.clock(),
    workingMode = nil,   -- какой метод реально принёс деньги
    selfBV      = nil,
    createdBVs  = {},    -- BV, созданные нами — чистим после рейса
}

local notifyFunc     = function() end  -- переопределяется после создания GUI
local setStatusFunc  = function() end

-- ═══════════════════════════ ПОИСК САМОЛЁТА ═══════════════════════════

-- Ищем все сиденья самолётов на островах рядом с персонажем
local function findNearSeats()
    local seats = {}
    local hrp = getHRP()
    if not hrp then return seats end
    local islands = workspace:FindFirstChild("Islands")
    if not islands then return seats end
    local myPos = hrp.Position
    for _, island in ipairs(islands:GetChildren()) do
        local placed = island:FindFirstChild("PlacedBlocks")
        if placed then
            for _, d in ipairs(placed:GetDescendants()) do
                if d:IsA("BasePart") and (d:IsA("VehicleSeat") or d:IsA("Seat") or string.find(string.lower(d.Name), "seat", 1, true)) then
                    local dist = (d.Position - myPos).Magnitude
                    if dist <= SEAT_RANGE then
                        table.insert(seats, d)
                    end
                end
            end
        end
    end
    return seats
end

-- Задаём скорость самолёту (BodyVelocity / LinearVelocity), создаём при необходимости.
-- Возвращает: количество разогнанных сидений.
local function applyPlaneVelocity()
    local boosted = 0
    for _, seat in ipairs(findNearSeats()) do
        local bv = seat:FindFirstChildOfClass("BodyVelocity")
        local lv = seat:FindFirstChildOfClass("LinearVelocity")
        if bv then
            bv.MaxForce = Vector3.new(1e12, 1e12, 1e12)
            bv.Velocity = PLANE_VEL
            boosted = boosted + 1
        elseif lv then
            pcall(function()
                lv.MaxForce = 1e12
                lv.VectorVelocity = PLANE_VEL
            end)
            boosted = boosted + 1
        else
            local okNew = pcall(function()
                local newBV = Instance.new("BodyVelocity")
                newBV.MaxForce = Vector3.new(1e12, 1e12, 1e12)
                newBV.Velocity = PLANE_VEL
                newBV.Parent = seat
                table.insert(Farm.createdBVs, newBV)
            end)
            if okNew then
                boosted = boosted + 1
            end
        end
    end
    return boosted
end

-- Пытаемся сесть в ближайшее сиденье (чтобы самолёт вёз персонажа)
local function trySitInPlane()
    local hrp, hum = getHRP()
    if not hrp or not hum then return false end
    if hum.SeatPart then return true end
    local seats = findNearSeats()
    if #seats == 0 then return false end
    -- ближайшее к персонажу
    table.sort(seats, function(a, b)
        return (a.Position - hrp.Position).Magnitude < (b.Position - hrp.Position).Magnitude
    end)
    local seat = seats[1]
    local ok = pcall(function()
        seat:Sit(hum)
    end)
    if ok and hum.SeatPart then return true end
    -- запасной вариант: переносим персонажа прямо в сиденье
    pcall(function()
        hrp.CFrame = seat.CFrame * CFrame.new(0, 2, 0)
        hum.Sit = true
    end)
    task.wait(0.3)
    return hum.SeatPart ~= nil
end

-- ── Очистка и страховка ──

local function stopSelfFlight()
    if Farm.selfBV then
        pcall(function() Farm.selfBV:Destroy() end)
        Farm.selfBV = nil
    end
    for _, bv in ipairs(Farm.createdBVs) do
        pcall(function() bv:Destroy() end)
    end
    Farm.createdBVs = {}
end

local function restorePosition(savedCFrame)
    local hrp = getHRP()
    if hrp and savedCFrame and hrp.Position.X > 1000 then
        pcall(function()
            hrp.CFrame = savedCFrame
        end)
    end
end

local function launchWatchdog()
    task.spawn(function()
        while Farm.flying do
            if os.clock() - Farm.launchT > Settings.flightTime + WATCHDOG_EXTRA then
                fireRemote(Remotes.Return)
                Farm.flying = false
                stopSelfFlight()
                notifyFunc("Страховка: принудительный возврат", Color3.fromRGB(255, 170, 60))
                break
            end
            task.wait(1)
        end
    end)
end

-- ── Старт методов ──

-- Разгон самолёта / самостоятельный полёт. Возвращает true, если скорость реально задана.
local function doRocketStart()
    local hrp, hum = getHRP()
    if not hrp or not hum then return false end

    local boosted = applyPlaneVelocity()
    if boosted > 0 then
        local seated = trySitInPlane()
        if seated then
            return true
        end
    end

    -- Самолёта нет / сесть не удалось: летим сами на BodyVelocity
    pcall(function()
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1e12, 1e12, 1e12)
        bv.Velocity = SELF_VEL
        bv.Parent = hrp
        Farm.selfBV = bv
    end)
    return Farm.selfBV ~= nil
end

local function doTeleportStart()
    local hrp = getHRP()
    if not hrp then return false end
    local targetX = 30 + Settings.tpDistance
    pcall(function()
        hrp.CFrame = CFrame.new(targetX, TP_ALT, 0)
    end)
    return true
end

-- ═══════════════════════════ ОДИН ЦИКЛ ФАРМА ═══════════════════════════

local function farmCycle()
    local ok, err = pcall(function()
        local hrp = getHRP()
        if not hrp then
            task.wait(2)
            hrp = getHRP()
            if not hrp then return end
        end

        local mode = Settings.method
        if mode == "АВТО" then
            mode = Farm.workingMode or "РАКЕТА"
        end

        local startCash = getCash()
        local savedCFrame = hrp.CFrame

        Farm.flying = true
        Farm.launchT = os.clock()
        setStatusFunc("Запуск самолёта...", Color3.fromRGB(120, 220, 255))

        fireRemote(Remotes.Launch)
        launchWatchdog()
        task.wait(LAUNCH_WAIT)

        if mode == "РАКЕТА" then
            setStatusFunc("Разгон до 1 000 000 000...", Color3.fromRGB(120, 220, 255))
            doRocketStart()
        else
            setStatusFunc("Телепорт на " .. formatMoney(Settings.tpDistance) .. " м...", Color3.fromRGB(120, 220, 255))
            doTeleportStart()
        end

        -- Поддерживаем скорость / высоту всё время полёта
        local reapply = task.spawn(function()
            while Farm.flying do
                if mode == "РАКЕТА" then
                    pcall(applyPlaneVelocity)
                    if Farm.selfBV and Farm.selfBV.Parent then
                        Farm.selfBV.Velocity = SELF_VEL
                    end
                else
                    local h2 = getHRP()
                    if h2 and h2.Position.Y > 100000 then
                        pcall(function()
                            h2.CFrame = CFrame.new(h2.Position.X, TP_ALT, h2.Position.Z)
                        end)
                    end
                end
                task.wait(0.25)
            end
        end)

        setStatusFunc("Полёт: " .. string.format("%.1f", Settings.flightTime) .. " сек...", Color3.fromRGB(120, 220, 255))
        task.wait(Settings.flightTime)

        setStatusFunc("Возврат и начисление...", Color3.fromRGB(120, 220, 255))
        fireRemote(Remotes.Return)
        Farm.flying = false

        task.wait(REWARD_WAIT)
        pcall(function() task.cancel(reapply) end)
        stopSelfFlight()
        restorePosition(savedCFrame)

        local earned = getCash() - startCash
        if earned > 0 then
            Farm.runs = Farm.runs + 1
            Farm.totalEarned = Farm.totalEarned + earned
            if Settings.method == "АВТО" then
                Farm.workingMode = mode
            end
            notifyFunc("+" .. shortMoney(earned) .. " $  (" .. mode .. ")", Color3.fromRGB(90, 255, 120))
        else
            -- Метод не принёс денег: в режиме АВТО пробуем другой
            if Settings.method == "АВТО" then
                if mode == "РАКЕТА" then
                    Farm.workingMode = "ТЕЛЕПОРТ"
                    notifyFunc("Ракета не сработала — следующий рейс: телепорт", Color3.fromRGB(255, 170, 60))
                else
                    Farm.workingMode = "РАКЕТА"
                    notifyFunc("Телепорт не сработал — следующий рейс: ракета", Color3.fromRGB(255, 170, 60))
                end
            else
                notifyFunc("Рейс без прибыли — проверьте самолёт/сиденье", Color3.fromRGB(255, 120, 120))
            end
            task.wait(2)
        end
    end)
    if not ok then
        warn("[INFINITY HUB] Ошибка цикла: " .. tostring(err))
        setStatusFunc("Ошибка цикла — перезапуск...", Color3.fromRGB(255, 120, 120))
        Farm.flying = false
        stopSelfFlight()
        task.wait(1)
    end
end

local function farmLoop()
    if not remotesReady then
        notifyFunc("Ремоуты не найдены — фарм невозможен", Color3.fromRGB(255, 120, 120))
        return
    end
    Farm.sessionCash = getCash()
    Farm.sessionT = os.clock()
    setStatusFunc("Авто-фарм запущен", Color3.fromRGB(90, 255, 120))
    Farm.loopId = (Farm.loopId or 0) + 1
    local myId = Farm.loopId
    while Farm.running and Farm.loopId == myId do
        farmCycle()
        if Farm.running and Farm.loopId == myId then
            task.wait(CYCLE_PAUSE)
        end
    end
    if Farm.loopId == myId then
        setStatusFunc("Авто-фарм остановлен", Color3.fromRGB(255, 200, 100))
    end
end

-- Принудительный безопасный останов
local function stopFarm()
    Farm.running = false
    Farm.loopId = (Farm.loopId or 0) + 1  -- инвалидируем текущий цикл
    if Farm.flying then
        fireRemote(Remotes.Return)
        Farm.flying = false
    end
    stopSelfFlight()
end

