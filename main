local toastHolder = make("Frame", {
    Size = UDim2.new(0, 240, 0, 400),
    Position = UDim2.new(1, -250, 0, 20),
    BackgroundTransparency = 1,
}, screenGui)
make("UIListLayout", {
    SortOrder = Enum.SortOrder.LayoutOrder,
    Padding = UDim.new(0, 6),
    HorizontalAlignment = Enum.HorizontalAlignment.Right,
}, toastHolder)

notifyFunc = function(text, color)
    task.spawn(function()
        local toast = make("TextLabel", {
            Size = UDim2.new(1, 0, 0, 30),
            BackgroundColor3 = COLORS.bg,
            BorderSizePixel = 0,
            Text = "  " .. text,
            TextColor3 = color or COLORS.text,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Font = Enum.Font.SourceSansSemibold,
            TextSize = 14,
            BackgroundTransparency = 0.15,
        }, toastHolder)
        make("UICorner", { CornerRadius = UDim.new(0, 8) }, toast)
        make("UIStroke", { Color = color or COLORS.accent, Thickness = 1, Transparency = 0.4 }, toast)
        task.wait(3)
        pcall(function()
            local tween = TweenService:Create(toast, TweenInfo.new(0.4), { BackgroundTransparency = 1, TextTransparency = 1 })
            tween:Play()
            tween.Completed:Wait()
            toast:Destroy()
        end)
    end)
end

setStatusFunc = function(text, color)
    statusLabel.Text = "Статус: " .. text
    statusLabel.TextColor3 = color or COLORS.text
end

-- ═══════════════════════════ СЧЁТЧИК СТАТИСТИКИ ═══════════════════════════

task.spawn(function()
    while true do
        pcall(function()
            local cash = getCash()
            cashLabel.Text = "Кэш: $" .. formatMoney(cash)
            local minutes = (os.clock() - Farm.sessionT) / 60
            local perMin = 0
            if minutes > 0.02 then
                perMin = math.floor(Farm.totalEarned / minutes)
            end
            statsLabel.Text = "Заработано: $" .. shortMoney(Farm.totalEarned) .. " • Рейсов: " .. tostring(Farm.runs) .. " • $/мин: " .. shortMoney(perMin)
        end)
        task.wait(0.5)
    end
end)

