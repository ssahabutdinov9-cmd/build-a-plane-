        if Settings.antiAfk then
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
        end
    end)
end

-- Список блоков для авто-покупки (подтверждённые ID из игры)
local BUY_ITEMS = {
    "block_1", "wing_1", "fuel_1", "propeller_1", "seat_1",
    "fuel_2", "wing_2", "fuel_3", "propeller_2", "balloon",
    "boost_1", "missile_1", "shield",
}

local function autoBuyLoop()
    task.spawn(function()
        while Settings.autoBuy do
            for _, item in ipairs(BUY_ITEMS) do
                if not Settings.autoBuy then break end
                fireRemote(Remotes.BuyBlock, item)
                task.wait(0.15)
            end
            task.wait(2)
        end
    end)
end

local function autoSpinLoop()
    task.spawn(function()
        while Settings.autoSpin do
            invokeRemote(Remotes.PurchaseSpin)
            invokeRemote(Remotes.PerformSpin)
            task.wait(1.2)
        end
    end)
end

local function auroraLoop()
    task.spawn(function()
        while Settings.aurora do
            pcall(function()
                if Remotes.AuroraCollect then
                    Remotes.AuroraCollect:FireServer(Instance.new("Part"))
                end
            end)
            task.wait(1.0)
        end
    end)
end

-- ═══════════════════════════ СОХРАНЕНИЕ НАСТРОЕК ═══════════════════════════

local function saveSettings()
    pcall(function()
        if not writefile then return end
        local body = HttpService:JSONEncode(Settings)
        if isfolder and not isfolder("INFINITY_HUB") then
            makefolder("INFINITY_HUB")
        end
        writefile(SETTINGS_PATH, body)
    end)
end

local function loadSettings()
    pcall(function()
        if not readfile then return end
        if isfile and isfile(SETTINGS_PATH) then
            local data = HttpService:JSONDecode(readfile(SETTINGS_PATH))
            for k, v in pairs(data) do
                if Settings[k] ~= nil then
                    Settings[k] = v
                end
            end
        end
    end)
end

loadSettings()

-- ═══════════════════════════ GUI ═══════════════════════════

-- Куда парентить GUI (gethui → CoreGui → PlayerGui)
local function getGuiParent()
    local ok, ui = pcall(function()
        if gethui then return gethui() end
        return nil
    end)
    if ok and ui then return ui end
    local ok2, core = pcall(function()
        local cg = game:GetService("CoreGui")
        local test = Instance.new("Folder")
        test.Name = "IH_test_" .. tostring(math.random(1e5))
        test.Parent = cg
        test:Destroy()
        return cg
    end)
    if ok2 and core then return core end
    return PlayerGui
end

local GUI_PARENT = getGuiParent()

-- Уничтожаем старую копию интерфейса
do
    local old = GUI_PARENT:FindFirstChild("INFINITY_HUB_BAP")
    if old then old:Destroy() end
    local oldPg = PlayerGui:FindFirstChild("INFINITY_HUB_BAP")
    if oldPg then oldPg:Destroy() end
end

