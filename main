local function make(className, props, parent)
    local inst = Instance.new(className)
    for k, v in pairs(props) do
        inst[k] = v
    end
    inst.Parent = parent
    return inst
end

local screenGui = make("ScreenGui", {
    Name = "INFINITY_HUB_BAP",
    ResetOnSpawn = false,
    IgnoreGuiInset = true,
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    DisplayOrder = 9999,
}, GUI_PARENT)

local uiScale = make("UIScale", { Scale = 1 }, screenGui)

-- Подгон масштаба под маленькие экраны (телефоны)
do
    local cam = workspace.CurrentCamera
    if cam then
        local function applyScale()
            local vp = cam.ViewportSize
            if vp.Y > 0 and vp.Y < 620 then
                uiScale.Scale = math.max(0.62, vp.Y / 620)
            else
                uiScale.Scale = 1
            end
        end
        applyScale()
        cam:GetPropertyChangedSignal("ViewportSize"):Connect(applyScale)
    end
end

